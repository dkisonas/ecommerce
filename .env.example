# Payload CMS
PAYLOAD_SECRET=your-secret-key-min-32-characters
DATABASE_URI=postgresql://user:password@localhost:5432/ecommerce

# Server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Draft preview
PREVIEW_SECRET=your-preview-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_

# Email (Resend)
RESEND_API_KEY=re_
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Your Store Name

# Paysera (optional - enable in Settings > Payments after configuring)
# PAYSERA_PROJECT_ID=your_project_id
# PAYSERA_SIGN_PASSWORD=your_sign_password
# PAYSERA_TEST_MODE=true
# NEXT_PUBLIC_PAYSERA_ENABLED=true

# Neopay (optional - enable in Settings > Payments after configuring)
# NEOPAY_MERCHANT_ID=your_merchant_id
# NEOPAY_SECRET_KEY=your_secret_key
# NEOPAY_TEST_MODE=true
# NEXT_PUBLIC_NEOPAY_ENABLED=true